# .gitignore - padrões gerais e específicos para este projeto

# Sistema / OS
.DS_Store
Thumbs.db
ehthumbs.db

# IDEs / editors
.vscode/
.idea/
*.suo
*.user
*.userosscache
.project
.classpath

# Node/npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.pytest_cache/
*.egg-info/

# Logs
logs/
*.log

# Environment / secrets
.env
.env.*
!.env.sample
!.env.host.sample
!.env.server-rpa.sample
!.env.server-dashboard.sample
!.env.help.json
secrets.*
*.key
*.pem
*.crt

# Installer runtime caches and generated files
**/installer-cache/
**/installer-cache/*
**/.cache/

# Build / distribution
dist/
build/

# Misc
*.swp
*.lock
.DS_Store

# CI artifacts
.coverage
coverage.xml

.data/
.cache/
logs/
media/
reports/

*.txt

# Estado de autoatualização do assistente (F00.06 — siscan-assistente-autoupdate.sh).
# Por default vive fora do repo (${XDG_STATE_HOME:-$HOME/.local/state}/siscan-assistente/),
# mas ignoramos o nome defensivamente caso SISCAN_UPDATE_STATE_FILE aponte para a árvore.
# Ancorado na raiz (/) — o único ponto in-tree possível é o $SCRIPT_DIR do clone;
# evita mascarar um update-state.json homônimo de outro contexto em subdiretórios.
/update-state.json
/update-state.json.lock
